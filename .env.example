# Optional: RPC URLs for specific chains (backend will auto-fetch if not set)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Optional: Minimum gas buffer in wei (1 ETH = 1000000000000000000 wei)
# Default: 0.1 ETH = 100000000000000000
MIN_GAS_BUFFER=100000000000000000

# Backend Logging
LOG_LEVEL=info
