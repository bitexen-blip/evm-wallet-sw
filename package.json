{
  "name": "evm-wallet-sweeper",
  "description": "Web dApp for sweeping all tokens and native balances from an EOA across EVM chains",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "sweep-wallet": "dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node dist/server/index.js",
    "dev": "vite",
    "build": "vite build",
    "build:all": "vite build && npm run server:build",
    "server:build": "tsc src/server/index.ts --outDir dist --declaration --module esnext --target esnext",
    "preview": "vite preview",
    "server": "tsx src/server/index.ts",
    "server:prod": "npm run build:all && node dist/server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.1.0",
    "@tanstack/react-query": "^5.28.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.11.0",
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.15.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "readline": "^1.3.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "viem": "^2.8.0",
    "wagmi": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "vite": "^5.0.0"
  }
}
